# Copy to .env and edit. Every value here is also settable as an environment
# variable; the defaults in configs/settings.py are what runs if you set nothing.

# ── Data ───────────────────────────────────────────────────────────────
DATA_SOURCE=revision                  # revision (real edits) | amazon (legacy)
DATA_CORPUS=arxiv                     # arxiv | python_docs | wikipedia
DATA_CORPUS_DIR=research/gates/results
DATA_N_WINDOWS=12
DATA_QUERIES_PER_WINDOW=300
DATA_MIN_WINDOW_SAMPLES=200
# DATA_MAX_DOCS=1000                  # cap the corpus for a fast run

# ── Embeddings ─────────────────────────────────────────────────────────
EMBED_BACKEND=minilm-numpy            # minilm-numpy (no torch) | sentence-transformers
EMBED_BATCH_SIZE=32
EMBED_MAX_LEN=256
# EMBED_MODEL_DIR=                    # override the MiniLM checkpoint location
# EMBED_MODEL_NAME=BAAI/bge-m3        # sentence-transformers backend only
# EMBED_DEVICE=cpu

# ── Drift ──────────────────────────────────────────────────────────────
DRIFT_N_PERM=199                      # permutations per window per channel
DRIFT_ALPHA_LEVEL=0.05                # false-alarm rate the calibration targets
DRIFT_TAU_Z_QUERY=2.0                 # regime thresholds, in null-standardised units
DRIFT_TAU_Z_CORPUS=2.0
DRIFT_PERSISTENCE_GATE=3
DRIFT_W1_N_PROJECTIONS=256
DRIFT_W1_BOOTSTRAP_ITERS=200
DRIFT_LAG=1
# DRIFT_THRESHOLD_TAU=0.15            # legacy; drives no alarm, kept for the
                                      # transfer experiment to show it failing

# ── Retrieval ──────────────────────────────────────────────────────────
RETRIEVAL_BACKEND=numpy               # numpy (exact) | chroma
RETRIEVAL_TOP_K=10
RETRIEVAL_SELECTOR=probe_knn          # probe_knn | cluster_threshold | random | oracle | changelog
RETRIEVAL_PROBE_FRAC=0.02

# ── Policy ─────────────────────────────────────────────────────────────
POLICY_LAM=1.0
POLICY_REGRET_SCALE=100.0             # compute-equivalent cost of total quality loss
POLICY_REINDEX_BUDGET=0.20
POLICY_COST_NO_OP=1.0
POLICY_COST_RERANK=4.0
POLICY_COST_REINDEX=22.0
POLICY_COST_FINETUNE=110.0
POLICY_COST_ESCALATE=1000.0

# ── Generation (optional; off by default) ──────────────────────────────
# The primary endpoint is retrieval recall@k, which needs no LLM. Turn this on
# only if you also want generated answers or RAGAS faithfulness.
OPENAI_ENABLED=false
OPENAI_API_KEY=local
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_GENERATION_MODEL=meta-llama-3.1-8b-instruct

# ── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_ENABLED=true
